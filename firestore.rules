// firestore.rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Match any document in the verifications collection
    match /verifications/{verificationId} {
      
      // Allow read access only to the user who owns the verification
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Disallow direct creation from the client
      allow create: if false;
      
      // Allow updates only to verificationStatus by admins
      allow update: if request.auth.token.admin == true
        && request.resource.data.keys().hasOnly(['verificationStatus'])
        && request.resource.data.verificationStatus in ['In-Progress', 'Approved', 'Rejected'];
    }
    
    // Allow users to read their own profile
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deny all other accesses
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
