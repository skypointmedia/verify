rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Main collection for the MVP: "businessRequests"
    match /businessRequests/{requestId} {

      // 1. CREATE:
      //    Allow authenticated users to create a doc if:
      //    - They set userId == their uid
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // 2. READ:
      //    - Admins can read all docs
      //    - Users can read docs where doc.userId == their uid
      allow read: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == resource.data.userId
      );

      // 3. UPDATE:
      //    - Admins can update any doc
      //    - Users can update their own doc
      //      (Optional: You can refine which fields they can update)
      allow update: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == resource.data.userId
      );

      // 4. DELETE:
      //    - Admins can delete any doc
      //    - Users can delete their own doc
      allow delete: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == resource.data.userId
      );
    }

    // Optional: If you store user profiles in "users/{userId}"
    match /users/{userId} {
      // Regular users can read/write their own user doc
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Admin can read/write any user doc
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Deny all other collections/paths by default for security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
